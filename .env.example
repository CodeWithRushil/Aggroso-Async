# Server Configuration
PORT=3001
NODE_ENV=development

# Optional AI LLM Provider Configuration
# If GEMINI_API_KEY is omitted, the application seamlessly runs using its built-in
# Deterministic Semantic Policy Engine with 100% offline accuracy and zero external costs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration
DATABASE_FILE=./data/marketplace_reviewer.sqlite

# Client Configuration (for Vite proxy / standalone)
VITE_API_URL=http://localhost:3001
